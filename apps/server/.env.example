# Server
PORT=5000
NODE_ENV=development

# Database (a replica set, not a plain standalone mongod - invite acceptance
# uses a transaction. `docker compose up -d mongo` runs one on 27018 for
# local dev; see docker-compose.yml for why the port isn't the default.)
MONGO_URI=mongodb://localhost:27018/edsync?replicaSet=rs0

# Auth
JWT_SECRET=replace-with-a-long-random-secret

# Email (Gmail app password - never commit real values)
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_APP_PASS=your-gmail-app-password

# Client (used for CORS origin)
CLIENT_URL=http://localhost:3000

# Redis (background email jobs - `docker compose up -d redis` for local dev)
REDIS_URL=redis://localhost:6379

# Cloudinary (class recordings - free tier). Browser uploads straight to
# Cloudinary with a signature minted by this server; point the Cloudinary
# console's Notification URL at POST /api/v1/webhooks/cloudinary.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Daily.co (live classes - free tier). DAILY_DOMAIN is the subdomain in
# https://<domain>.daily.co. Rooms are private; this server mints join tokens.
DAILY_API_KEY=your-daily-api-key
DAILY_DOMAIN=your-daily-subdomain
